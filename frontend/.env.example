# SpendGuard frontend (devnet only).
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time.
# Never put secrets, API keys or keypair material here.

# Devnet RPC endpoint. Use a public devnet URL or a keyless/demo-only provider.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed SpendGuard program (must match contracts/Anchor.toml and the IDL).
NEXT_PUBLIC_PROGRAM_ID=AzvuWQBBrawzLRFYkH7DiCY4c9326cnncJWGkySnEsEZ

# SpendGuard backend HTTP API.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
