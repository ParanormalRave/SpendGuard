# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored. Never commit real keys, tokens or passwords.

# --- Solana (devnet or localnet ONLY, never mainnet) ---
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=AzvuWQBBrawzLRFYkH7DiCY4c9326cnncJWGkySnEsEZ

# --- Keypairs ---
# These are paths, not key material. The files themselves are gitignored
# (keys/ and *-keypair.json). Generate with:
#   solana-keygen new --no-bip39-passphrase -o backend/keys/agent-keypair.json
AGENT_KEYPAIR_PATH=./keys/agent-keypair.json
KEEPER_KEYPAIR_PATH=./keys/keeper-keypair.json
# Owner wallet for owner-only demo scripts (for example src/scripts/withdrawDemo.ts).
# Path only; the file itself is gitignored.
OWNER_KEYPAIR_PATH=./keys/owner-keypair.json

# --- Policy the demo operates on (set after creating a policy) ---
POLICY_ADDRESS=

# --- LLM for the agent tool loop (Groq, OpenAI-compatible) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here  
LLM_MODEL=openai/gpt-oss-120b

# --- Anomaly thresholds ---
UNUSUAL_MULTIPLIER=3
UNUSUAL_MIN_HISTORY=3
NEAR_LIMIT_PERCENT=80

# --- HTTP API (M4F) ---
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# --- Google sign-in and email (M7) ---
GOOGLE_CLIENT_ID=
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
